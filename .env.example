
DATABASE_URL="postgresql://bonza:bonza_dev@localhost:5432/bonza"

# Claude API — leave as the placeholder to use deterministic mock data offline.
ANTHROPIC_API_KEY="random-api-key"

# Clerk — owns all authentication. Get the keys from clerk.com -> API Keys.
# Required: the app will not run without CLERK_SECRET_KEY + a publishable key.
# Test keys (pk_test_/sk_test_) work fully in local dev; use live keys in prod.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."   # client-safe (bundled into the SPA)
CLERK_PUBLISHABLE_KEY="pk_test_..."        # same value, read by @clerk/express
CLERK_SECRET_KEY="sk_test_..."             # server only — never VITE_ prefix this
CLERK_WEBHOOK_SECRET="whsec_..."           # Clerk -> Webhooks (user.created/deleted sync)

# Environment
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Plaid — mock during development (real integration is post-launch)
PLAID_CLIENT_ID="mock"
PLAID_SECRET="mock"

# Loyalty email sync (Phase 8b) — leave unset/false to use the deterministic mock
# sync offline. Set to "true" in prod once a Gmail/Outlook OAuth access-token flow
# exists; /api/v1/loyalty/sync-email then parses real statement emails.
EMAIL_SYNC="false"

# Loyalty OAuth (Phase 10) — Gmail + Outlook auth-code flow that obtains the token the
# loyalty email-parse reads. Blank => the "Connect" buttons run the deterministic mock
# sync (fully offline). To go live, set the provider client id/secret AND register the
# redirect URI OAUTH_REDIRECT_BASE + /auth/<provider>/callback with the provider.
#   Google:    console.cloud.google.com → OAuth client → scope gmail.readonly
#   Microsoft: entra.microsoft.com → App registration → Graph Mail.Read + offline_access
VITE_GMAIL_CLIENT_ID=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Public base the provider redirects back to (must match the registered redirect URIs).
OAUTH_REDIRECT_BASE="http://localhost:5000"

# Duffel (Phase 8c) — real flight + hotel inventory. Leave blank to use the mock
# inventory offline; set a real token (duffel_test_… / duffel_live_…) to route the
# /flights/search, /flights/confirm-price and /hotels/search endpoints to Duffel.
DUFFEL_API_KEY=""

# Seats.aero (Phase 8d) — real award flight availability. Blank => mock awards.
SEATS_AERO_API_KEY=""

# CarTrawler (Phase 8k) — real rental-car inventory. Blank => /cars serves the offline
# mock (utils/mockCars); a real key is reserved for the post-launch CarTrawler integration.
CARTRAWLER_API_KEY=""

# Gondola MCP (Phase 8e) — remote HTTP MCP server for award HOTEL cash+points pricing.
# No API key. The optimizer's real Claude path attaches it via the Anthropic MCP
# connector. Defaults to the public URL if unset.
GONDOLA_MCP_URL="https://mcp.gondola.ai/mcp"

# Affiliate networks (Phase 8i) — commission on outbound deep-links. Each network is
# wrapped independently; a blank token => that network's links are returned unwrapped
# (raw portal URLs), so award search + click tracking work fully offline. Travelpayouts
# wraps flight/hotel outbound generally; Awin wraps Marriott/Hilton (advertiser ids are
# fixed in code), Impact wraps Hyatt. Clicks are always logged to AffiliateClick.
TRAVELPAYOUTS_TOKEN=""
AWIN_AFFILIATE_ID=""
IMPACT_HYATT_CAMPAIGN_ID=""

# Bonza Pro paywall (Phase 8d+) — leave false so Pro-gated endpoints (award search,
# redemption engine, cashback) work in dev. Set "true" in prod to require an active
# Subscription.
PRO_ENFORCED="false"

# Stripe (Phase 8g) — Bonza Pro subscription (£49.99/yr). Leave STRIPE_SECRET_KEY blank
# to use the offline mock path: POST /subscriptions/create flips the user to Pro locally
# (no real charge) so the upgrade flow is testable in dev. Set a real sk_test_/sk_live_
# key to route through Stripe Checkout. STRIPE_PRO_ANNUAL_PRICE_ID is the annual Price
# from the Stripe dashboard; STRIPE_WEBHOOK_SECRET (whsec_…) verifies the webhook (use
# the Stripe CLI locally). VITE_STRIPE_PUBLISHABLE_KEY (pk_test_/pk_live_) is client-safe
# and now powers on-site cash-booking payments via Stripe Elements on /booking (PaymentIntent
# uses STRIPE_SECRET_KEY). Leave it blank to use the offline mock booking path (mock
# PaymentIntent — bookings still write). Not needed for the Pro redirect Checkout flow.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Email + notifications (Phase 9) — Resend. Leave RESEND_API_KEY blank to use the offline
# mock path: notification triggers still create in-app Notification rows (the bell works),
# emails are logged not sent. Set a real re_… key (+ verified sending domain) to send live.
# EMAIL_FROM must be an address on your verified domain.
RESEND_API_KEY=""
EMAIL_FROM="Bonza <notifications@bonza.app>"

# Sentry (Phase 11f) — error tracking + performance monitoring. Leave blank to disable
# entirely: without a DSN, Sentry never initialises (server + client) and the app runs
# with zero Sentry overhead offline. Set the DSN from sentry.io -> Project -> Client Keys.
# SENTRY_DSN is server-side; VITE_SENTRY_DSN is the SAME value exposed to the client (a
# Sentry DSN is safe to publish). GIT_COMMIT_SHA / VITE_GIT_COMMIT_SHA tag the release
# (set by CI at build time; optional locally).
SENTRY_DSN=""
VITE_SENTRY_DSN=""
