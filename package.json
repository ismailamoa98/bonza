{
  "name": "bonza-travel-app",
  "version": "0.1.0",
  "description": "Bonza - AI Travel Optimizer. Optimizing travel with loyalty points.",
  "main": "src/backend/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/backend/index.js",
    "dev": "nodemon src/backend/index.js",
    "db:setup": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node src/backend/db/seed.js",
    "db:seed:e2e": "node src/backend/db/seedE2e.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project backend --project frontend",
    "test:int": "vitest run --project integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "vitest run --coverage && playwright test",
    "start:e2e:api": "node src/backend/index.js",
    "start:e2e:web": "npm --prefix src/frontend run dev -- --host --port 3000",
    "dev:test": "npm run start:e2e:api & npm run start:e2e:web & wait",
    "lint": "eslint ."
  },
  "prisma": {
    "schema": "src/backend/db/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@aws-sdk/client-secrets-manager": "^3.734.0",
    "@clerk/express": "^2.1.29",
    "@duffel/api": "^4.27.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.5.0",
    "prisma": "^5.22.0",
    "resend": "^6.18.0",
    "stripe": "^22.2.2",
    "svix": "^1.96.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "nodemon": "^3.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
