datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // Clerk owns identity. `id` holds Clerk's userId (e.g. "user_2abc…"), NOT a cuid —
  // it's set from the webhook / JIT sync, or the fixed dev-demo id when seeded.
  id                String    @id
  email             String    @unique
  name              String?
  location          String?
  travelStatus      String?
  createdAt         DateTime  @default(now())

  trips             Trip[]
  bookingLinks      BookingLink[]
  chatSessions      ChatSession[]

  subscription      Subscription?
  bonzaCredits      BonzaCredit[]
  loyaltyAccounts   LoyaltyAccount[]
  affiliateClicks   AffiliateClick[]
}

model Trip {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  origin            String
  destination       String
  checkIn           DateTime
  checkOut          DateTime
  budget            Int
  numberOfTravelers Int       @default(1)
  flexibility       Boolean   @default(false)

  loyaltyPoints     Json
  preferences       Json

  scenarios         Scenario[]
  bookingLinks      BookingLink[]
  chatSessions      ChatSession[]

  createdAt         DateTime  @default(now())
}

model Scenario {
  id                String    @id @default(cuid())
  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id])

  strategy          String    // "transfer", "status", "cash", "hybrid", "direct"
  totalCashCost     Int
  pointsUsed        Int
  pointsProgram     String

  flightDetails     Json
  hotelDetails      Json
  carDetails        Json

  benefits          Json
  reasoning         String
  valueMultiplier   Float     // 1.41 for "+41% Value"
  savingsAmount     Int

  isRecommended     Boolean   @default(false)

  createdAt         DateTime  @default(now())
}

model ChatSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id])

  selectedScenarioId String?  // Updates as user changes selection

  messages          ChatMessage[]

  createdAt         DateTime  @default(now())
}

model ChatMessage {
  id                String    @id @default(cuid())
  sessionId         String
  session           ChatSession @relation(fields: [sessionId], references: [id])

  role              String    // "user" or "bonza"
  content           String

  createdAt         DateTime  @default(now())
}

model BookingLink {
  id                String    @id @default(cuid())
  token             String    @unique @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id])

  selectedScenarioId String?

  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  viewedAt          DateTime?

  affiliateLinks    AffiliateLink[]
  conversions       Conversion[]
}

model AffiliateLink {
  id                String    @id @default(cuid())
  bookingLinkId     String
  bookingLink       BookingLink @relation(fields: [bookingLinkId], references: [id])

  type              String    // "flight", "hotel", "car"
  vendor            String    // "United", "Marriott", "Hertz"
  affiliateUrl      String
  trackingId        String
  commissionRate    Float

  createdAt         DateTime  @default(now())
}

model Conversion {
  id                String    @id @default(cuid())
  bookingLinkId     String
  bookingLink       BookingLink @relation(fields: [bookingLinkId], references: [id])

  type              String    // "flight", "hotel", "car"
  vendor            String
  bookingId         String?
  commissionAmount  Float?

  createdAt         DateTime  @default(now())
}
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])

  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  status               String    // "active" | "cancelled" | "past_due" | "trialing"
  plan                 String    @default("pro_annual") // "pro_annual" | "free"
  currentPeriodEnd     DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model BonzaCredit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  amount            Float     // GBP, e.g. 24.00
  source            String    // "cashback_hotel" | "cashback_flight" | "cashback_car" | "first_booking_bonus" | "redeemed"
  bookingId         String?   // ref to the booking that generated this credit (no FK — bookings live as BookingLink/Conversion)

  createdAt         DateTime  @default(now())
  expiresAt         DateTime  // credits expire 24 months from earning
}

model LoyaltyAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  programme         String    // "marriott_bonvoy" | "hilton_honors" | "world_of_hyatt" | "ihg_one" | "amex_mr" | "chase_ur" | "united_mp" | "ba_avios"
  accountNumber     String?   // masked — last 4 only
  balance           Int       // points
  valueGbp          Float     // estimated £ value at current programme rate
  statusTier        String?   // "Silver" | "Gold" | "Platinum" | "Sapphire" | "Globalist" etc.
  lastSynced        DateTime
  syncMethod        String    // "email_parse" | "manual" | "awardwallet"

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, programme])
}

model AffiliateClick {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])

  programme         String    // "travelpayouts" | "awin_marriott" | "awin_hilton" | "impact_hyatt" | "cj_seatsaero"
  destination       String    // URL clicked
  bookingType       String    // "cash" | "points" | "hybrid"
  leg               String    // "flight" | "hotel" | "car"

  clickedAt         DateTime  @default(now())
  convertedAt       DateTime?
  commissionEst     Float?    // estimated £ commission if known
}
