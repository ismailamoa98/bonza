// Prisma schema — source of truth for the Bonza data model.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id
  email        String   @unique
  name         String?
  location     String?
  travelStatus String?
  createdAt    DateTime @default(now())

  deviceFingerprint String?

  lastLoginAt DateTime?
  homeAirport String?

  onboardingComplete  Boolean @default(false)
  travelStyle         String?

  // Traveller profile — collected in onboarding to pre-fill the booking guest form (no card data stored).
  title           String?
  firstName       String?
  lastName        String?
  dateOfBirth     String? // "YYYY-MM-DD"
  phone           String?
  phoneCountryCode String? @default("+44")
  passportNumber  String?
  gmailConnected      Boolean @default(false)
  gmailRefreshToken   String?
  outlookConnected    Boolean @default(false)
  outlookRefreshToken String?

  trips        Trip[]
  bookingLinks BookingLink[]
  chatSessions ChatSession[]

  subscription    Subscription?
  bonzaCredits    BonzaCredit[]
  loyaltyAccounts LoyaltyAccount[]
  affiliateClicks AffiliateClick[]
  bookings        Booking[]
  journeys        UserJourney[]
  events          UserEvent[]
  recommendations PersonalisedRecommendation[]

  notifications          Notification[]
  notificationPreference NotificationPreference?

  propertyReviews PropertyReview[]
  pointsActivity  PointsActivity[]
  syncRuns        BalanceSyncRun[]
}

model Trip {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  origin            String
  destination       String
  checkIn           DateTime
  checkOut          DateTime
  budget            Int
  numberOfTravelers Int      @default(1)
  flexibility       Boolean  @default(false)

  loyaltyPoints Json
  preferences   Json

  scenarios    Scenario[]
  bookingLinks BookingLink[]
  chatSessions ChatSession[]

  createdAt DateTime @default(now())
}

model Scenario {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  strategy      String // "transfer", "status", "cash", "hybrid", "direct"
  totalCashCost Int
  pointsUsed    Int
  pointsProgram String

  flightDetails Json
  hotelDetails  Json
  carDetails    Json

  benefits        Json
  reasoning       String
  valueMultiplier Float // 1.41 for "+41% Value"
  savingsAmount   Int

  isRecommended Boolean @default(false)

  createdAt DateTime @default(now())
}

model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  selectedScenarioId String? // Updates as user changes selection

  messages ChatMessage[]

  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])

  role    String // "user" or "bonza"
  content String

  createdAt DateTime @default(now())
}

model BookingLink {
  id     String @id @default(cuid())
  token  String @unique @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  selectedScenarioId String?

  expiresAt DateTime
  createdAt DateTime  @default(now())
  viewedAt  DateTime?

  affiliateLinks AffiliateLink[]
  conversions    Conversion[]
}

model AffiliateLink {
  id            String      @id @default(cuid())
  bookingLinkId String
  bookingLink   BookingLink @relation(fields: [bookingLinkId], references: [id])

  type           String // "flight", "hotel", "car"
  vendor         String // "United", "Marriott", "Hertz"
  affiliateUrl   String
  trackingId     String
  commissionRate Float

  createdAt DateTime @default(now())
}

model Conversion {
  id            String      @id @default(cuid())
  bookingLinkId String
  bookingLink   BookingLink @relation(fields: [bookingLinkId], references: [id])

  type             String // "flight", "hotel", "car"
  vendor           String
  bookingId        String?
  commissionAmount Float?

  createdAt DateTime @default(now())
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  status               String // 'active' | 'cancelled' | 'past_due' | 'trialing' | 'pending'
  plan                 String    @default("pro_annual") // 'pro_annual' | 'free'
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BonzaCredit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount    Float // in GBP, e.g. 24.00
  source    String // 'cashback_hotel' | 'cashback_flight' | 'cashback_car' | 'first_booking_bonus' | 'redeemed'
  bookingId String? // reference to the booking that generated this credit
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime // credits expire 24 months from earning
}

model LoyaltyAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  programme     String // 'marriott_bonvoy' | 'hilton_honors' | 'world_of_hyatt' | 'ihg_one' | 'amex_mr' | 'chase_ur' | 'united_mp' | 'ba_avios'
  accountNumber String? // masked — last 4 only (display)

  programmeAccountId  String?
  loyaltyEmailAddress String?

  balance    Int // points
  valueGbp   Float // estimated £ value at current programme rate
  statusTier String? // 'Silver' | 'Gold' | 'Platinum' | 'Globalist' etc.

  pointsExpireAt DateTime?
  statusRenewsAt DateTime? // Phase 14: when elite status is reviewed (email-parsed; nullable)
  nightsThisYear Int? // Phase 14: hotel status progress (email-parsed; nullable)

  lastSynced DateTime
  syncMethod String // 'email_parse' | 'manual' | 'awardwallet'

  // Phase 15: statement-authoritative sync state (presentation — seeded in dev).
  syncState        String    @default("not_checked") // 'verified' | 'updated' | 'not_checked'
  previousBalance  Int? // value before the last statement update (only when it changed)
  statementDate    DateTime? // date of the statement the balance came from
  statementSource  String? // mailbox address the statement was sent to
  manualOverrideAt DateTime? // user edited by hand; holds until a newer statement arrives

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user may hold multiple memberships in one programme, distinguished by membership number.
  @@unique([userId, programme, accountNumber])
  @@unique([programme, programmeAccountId]) // same loyalty account can't link to two Bonza users
  @@unique([programme, loyaltyEmailAddress]) // same statement email per programme can't link twice
}

// Phase 15: a record of one statement-sync run so the review page can report on it (presentation —
// seeded in dev). modalPending gates the one-time discrepancy modal.
model BalanceSyncRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  mailbox     String // 'gmail' | 'outlook'

  programmesChecked Int @default(0)
  statementsFound   Int @default(0)
  balancesUpdated   Int @default(0)
  balancesVerified  Int @default(0)
  notChecked        Int @default(0)

  modalPending Boolean @default(true) // false once the user has seen the modal for this run

  @@index([userId, startedAt])
}

model AffiliateClick {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  programme   String // 'travelpayouts' | 'awin_marriott' | 'awin_hilton' | 'impact_hyatt' | 'cj_seatsaero'
  destination String // URL clicked
  bookingType String // 'cash' | 'points' | 'hybrid'
  leg         String // 'flight' | 'hotel' | 'car'

  clickedAt     DateTime  @default(now())
  convertedAt   DateTime?
  commissionEst Float? // estimated £ commission if known
}

model Booking {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  journeyId String?
  journey   UserJourney? @relation(fields: [journeyId], references: [id])

  tripId      String?
  origin      String?
  destination String?
  checkIn     DateTime?
  checkOut    DateTime?
  travelers   Int       @default(1)

  leg         String // 'flight' | 'hotel' | 'car' | 'package'
  bookingType String // 'cash' | 'points' | 'hybrid'
  supplier    String // 'duffel' | 'marriott_bonvoy' | … | 'cartrawler' | 'self_reported'

  // Property identity for hotel legs — lets a confirmed guest leave a verified review (see PropertyReview).
  propertyName      String?
  propertyPlaceId   String? // Google Places place_id (resolved at booking time)
  supplierReference String? // Duffel booking reference / loyalty confirmation number
  description       String? // e.g. "LHR → NCE · British Airways · Economy"

  cashValueGbp    Float?
  pointsUsed      Int?
  pointsProgramme String?
  pointsValueGbp  Float?
  serviceFeeGbp   Float? // Bonza service fee (cash bookings only)

  confirmedAt        DateTime
  confirmationMethod String // 'duffel' | 'affiliate_postback' | 'self_reported' | 'transfer_proxy'

  status             String    @default("confirmed") // 'confirmed' | 'cancelled' | 'completed' | 'pending'
  cancelledAt        DateTime?
  cancellationReason String?

  creditsAwarded Float? // Bonza Credits issued for this booking
  credits        BonzaCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserJourney {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tripId      String?
  origin      String?
  destination String?
  travelDates String?

  recommendedScenario  String? // 'points' | 'transfer' | 'hybrid' | 'cash'
  recommendedProgramme String?
  pointsRecommended    Int?

  transferConfirmed   Boolean   @default(false)
  transferProgramme   String? // e.g. 'chase_ur'
  transferToProgramme String? // e.g. 'aeroplan'
  transferAmount      Int?
  transferConfirmedAt DateTime?

  deepLinkClicked   Boolean   @default(false)
  deepLinkClickedAt DateTime?
  deepLinkLeg       String? // 'flight' | 'hotel' | 'car'

  bookingConfirmed   Boolean   @default(false)
  bookingMethod      String? // 'duffel' | 'self_reported' | 'affiliate_postback' | 'transfer_proxy'
  bookingConfirmedAt DateTime?
  bookingValueGbp    Float?

  creditsAwarded   Float?
  creditsAwardedAt DateTime?
  isFirstBooking   Boolean   @default(false)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type      String // e.g. 'booking_confirmed' | 'booking_cancelled'
  metadata  Json
  sessionId String?

  createdAt DateTime @default(now())
}

model AwardAvailability {
  id          String   @id @default(cuid())
  userId      String
  origin      String
  destination String
  programme   String
  date        DateTime
  cabin       String
  pointsCost  Int
  seatsAvail  Int?
  taxesGbp    Float?
  bookingUrl  String? // deep-link to the loyalty portal
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime // 24h TTL

  @@index([userId, origin, destination])
  @@index([expiresAt])
}

model PersonalisedRecommendation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  destination     String // city name — maps to PackageCard title
  destinationCity String // display name
  origin          String
  imageUrl        String?
  specLine        String // "5 NTS · 5-STAR · LHR → LIS"
  rating          Float?

  pointsOption Json? // { programme, pointsCost, cabin, availableDates[], valueGbp, centsPerPoint, aboveBenchmark, bookingUrl, seatsAvailable, source }
  cashOption   Json? // { priceGbp, supplier, creditsEarned, offerId }
  hotelOption  Json? // { name, programme, pointsCost, cashPrice, creditsEarned, nights, source }

  aiInsight       String // one line, surfaced as the card's rec
  whyPersonalised String // eyebrow — "You searched Lisbon 3 times"
  urgencySignal   String? // "3 seats left" | "Avios expire in 87 days" | null

  bestOptionType    String // 'points' | 'cash' | 'hybrid'
  pointsValueRating String // 'excellent' | 'good' | 'typical' | 'below_average'
  centsPerPoint     Float?
  cashSavingGbp     Float?
  creditsIfCash     Float? // 3% of the cash package — always populated

  isActive    Boolean   @default(true)
  viewedAt    DateTime?
  clickedAt   DateTime?
  generatedAt DateTime  @default(now())
  expiresAt   DateTime // 48h TTL

  @@index([userId, isActive, expiresAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type     String // award_availability | expiry_warning | price_drop | monthly_summary |
  title    String // short headline — shown in the bell panel
  body     String // full message — shown expanded
  ctaLabel String?
  ctaUrl   String?

  bookingId String?
  journeyId String?
  programme String?

  readAt      DateTime?
  emailSentAt DateTime?
  dismissedAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime? // null = never expires

  @@index([userId, dismissedAt, createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  awardAlerts     Boolean @default(true)
  expiryWarnings  Boolean @default(true)
  priceDropAlerts Boolean @default(true)
  monthlySummary  Boolean @default(true)
  bookingUpdates  Boolean @default(true) // transactional — kept true
  proUpdates      Boolean @default(true) // transactional — kept true

  updatedAt DateTime @updatedAt
}

// Recorded, derived aspect scores per property (analysed from review text). Stores OUR analysis only —
// never the raw Google review text (ToS). Refreshed when stale; keyed by Google place_id.
model PropertyInsight {
  id      String  @id @default(cuid())
  placeId String  @unique
  name    String?
  city    String?

  location   Float // 0–10
  comfort    Float // 0–10
  facilities Float // 0–10
  summary    String? // one-line Bonza summary of the property's status
  sampleSize Int     @default(0)
  rating     Float? // overall rating at time of analysis
  source     String  @default("claude") // 'claude' | 'keyword'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bonza verified reviews — only users with a confirmed booking for the property can post.
model PropertyReview {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  bookingId    String?
  placeId      String
  propertyName String?

  rating     Int // overall 1–5
  location   Int? // 1–5
  comfort    Int? // 1–5
  facilities Int? // 1–5
  text       String

  status    String   @default("published") // 'published' | 'hidden'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, placeId])
  @@index([placeId, status, createdAt])
}

// ── Phase 14: Points Portfolio ──────────────────────────────────────────────
// Bonza-maintained programme valuations (cents-per-point) + transfer graph. Reference data seeded once
// (seedProgrammes.js) and refreshed nightly (valuationRefreshJob.js). The /points page renders from these
// cached rows rather than any live third-party API.
model ProgrammeValuation {
  id        String @id @default(cuid())
  programme String @unique // 'marriott_bonvoy' | 'amex_mr' | 'ba_avios' | ...

  displayName String
  category    String // 'hotel' | 'airline' | 'card' | 'car'
  brandColor  String // hex for the row dot / logo-tile initials

  logoUrl  String? // Phase 14: CloudFront path, e.g. "/logos/ba.svg"; null → initials fallback
  initials String  @default("?") // Phase 14: fallback mark — "BA", "AX", "M", "IHG"

  centsPerPoint Float // current valuation, e.g. 0.8
  benchmarkCpp  Float // programme's typical rate for comparison
  currency      String @default("pts") // 'pts' | 'miles' | 'Avios'

  isTransferable     Boolean @default(false) // Amex MR, Chase UR, Marriott
  hasPointsProgramme Boolean @default(true) // false for car-rental status programmes

  updatedAt       DateTime @updatedAt
  lastRefreshedAt DateTime @default(now())

  transfersFrom TransferPartner[] @relation("FromProgramme")
  transfersTo   TransferPartner[] @relation("ToProgramme")
}

// Phase 14: points activity feed. Read-only surface for now — rows are seeded (dev) or would be written by
// a future derivation/booking pipeline. See FULL_CLAUDE.md §14e/§14h.
model PointsActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  programme String
  accountId String? // links to LoyaltyAccount when known

  kind        String // 'earn' | 'spend' | 'transfer_in' | 'transfer_out' | 'expiry' | 'adjustment'
  description String // "Marriott Lisbon · 4 nights" | "Points earned"
  detail      String? // secondary line: "stay credit" | "1:1 ratio" | "statement Feb"

  amount     Int // signed — positive for earn/transfer_in, negative for spend/transfer_out
  occurredAt DateTime

  source     String // 'confirmation_email' | 'balance_delta' | 'bonza_booking' | 'user_entered'
  confidence String // 'confirmed' | 'inferred'

  relatedProgramme  String?
  relatedActivityId String?
  bookingId         String?
  createdAt         DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([userId, programme, occurredAt])
}

model TransferPartner {
  id String @id @default(cuid())

  fromProgramme String
  from          ProgrammeValuation @relation("FromProgramme", fields: [fromProgramme], references: [programme])

  toProgramme String
  to          ProgrammeValuation @relation("ToProgramme", fields: [toProgramme], references: [programme])

  ratioFrom       Int // e.g. 3 for Marriott 3:1
  ratioTo         Int // e.g. 1
  transferTimeHrs Int? // typical transfer time in hours; null if instant/unknown
  minimumTransfer Int? // minimum points that can be transferred
  isActive        Boolean @default(true) // false when a partnership ends
  bonusActive     Boolean @default(false) // true during a transfer bonus promotion
  bonusPercent    Int? // e.g. 30 for a 30% transfer bonus

  updatedAt DateTime @updatedAt

  @@unique([fromProgramme, toProgramme])
  @@index([fromProgramme, isActive])
}

// ── Phase 17: Hero Destination Board ────────────────────────────────────────
// Factual award-price board shown on the marketing hero, tied to the destination slideshow. Seeded
// reference data (seedHeroDestinations.js), refreshed monthly (jobs/heroDestinationJob.js).
model HeroDestination {
  id       String @id @default(cuid())
  slug     String @unique // 'capetown'
  name     String // 'Cape Town, South Africa'
  tagline  String @default("") // editorial title — theme · season · place, e.g. 'Bali Summer Getaway'
  imageUrl String // '/auth/capetown.jpg'
  gradient String // fallback backdrop
  sortOrder Int    @default(0)
  isActive  Boolean @default(true)

  // Board context — what the quoted prices assume
  nights      Int     @default(5)
  adults      Int     @default(2)
  travelMonth String? // 'March 2026' — display only

  // The whole trip flown in cash (points are the hotel's job here). Seeded now; a Duffel pull later.
  // Defaults keep `db push` safe on the existing rows; the seed upsert overwrites with real values.
  originCode String  @default("LHR")
  destCode   String  @default("") // 'DPS'
  routeLabel String  @default("") // 'London → Denpasar'
  carrier    String? // 'Qatar Airways'
  flightCash Int     @default(0) // £, return, total for `adults` — whole pounds

  awards      DestinationAward[]
  refreshedAt DateTime @default(now())
}

model DestinationAward {
  id String @id @default(cuid())

  destinationSlug String
  destination     HeroDestination @relation(fields: [destinationSlug], references: [slug], onDelete: Cascade)

  programme    String // 'world_of_hyatt' | 'marriott_bonvoy' | 'hilton_honors' | 'ihg_one'
  propertyName String // 'The Silo Hotel'
  propertyCode String? // programme's own hotel code, for the deep-link
  pointsTotal  Int // total for the destination's `nights` (whole stay, never per-night)
  hotelCash    Int     @default(0) // £, whole-stay cash rate for the same property — whole pounds
  starRating   Int?

  sortOrder   Int      @default(0) // ascending points — cheapest first
  refreshedAt DateTime @default(now())

  @@unique([destinationSlug, programme])
  @@index([destinationSlug, sortOrder])
}

// Phase 18 — homepage discovery rails. Standalone reference data (no relations), seeded and refreshed
// monthly alongside the hero destinations. All cash figures are whole-pound totals; the frontend only adds.
model ExploreCountry {
  id       String   @id @default(cuid())
  code     String   @unique // ISO 3166-1 alpha-2, e.g. 'es'
  name     String // 'Spain'
  continent String  @default("") // grouping label (reuses the 6 discovery regions) — for the map + grid
  latitude  Float? // pin anchor — country centroid
  longitude Float?
  imageUrl String? // '/explore/es.jpg' — null for directory-only countries
  heroImageUrl String? // Phase 19 — wide 1400×500 country hero; null → falls back to imageUrl then gradient
  blurb        String? // Phase 19 — one-line country blurb for the meta description (optional)
  gradient String // fallback backdrop
  sortOrder Int    @default(0)
  isActive  Boolean @default(true)

  // Cheapest award entry point into the country (discovery-rail "from X pts"). Refreshed monthly.
  fromPoints    Int? // 26000
  fromCurrency  String? // 'Avios' | 'pts'
  fromProgramme String? // 'ba_avios'

  cities  ExploreCity[]
  routes  ExploreRoute[]

  refreshedAt DateTime @default(now())
}

// Phase 18 (Explore Everywhere) — bookable cities per country, and cached origin→country/city prices.
model ExploreCity {
  id          String @id @default(cuid())
  countryCode String
  country     ExploreCountry @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  name           String // 'Lisbon'
  iataCode       String // 'LIS'
  imageUrl       String?
  hotelsOnPoints Int     @default(0) // count of award properties (mock now; Rooms.aero later)

  // City drawer — holiday type (drawer tagline) + typical hotel cost + flight metadata (mock).
  holidayType     String? // 'Beach' | 'City break' | 'Culture' | 'Adventure'
  hotelCashFrom   Int? // £, whole-stay cheapest award property
  hotelPointsFrom Int? // cheapest award for the stay
  hotelProgramme  String? // 'world_of_hyatt'
  carrier         String? // 'British Airways'
  flightMinutes   Int? // one-way duration
  isDirect        Boolean @default(true)

  routes       ExploreRoute[]
  hotels       ExploreHotel[]
  availability ExploreAvailability[]

  @@unique([countryCode, iataCode])
}

// Phase 18 §18i — named award properties per city (drawer "Hotels on points"), + a rolling six-month
// award-availability window per origin.
model ExploreHotel {
  id     String @id @default(cuid())
  cityId String
  city   ExploreCity @relation(fields: [cityId], references: [id], onDelete: Cascade)

  programme    String // 'world_of_hyatt'
  propertyName String // 'Andaz Munich Schwabinger Tor'
  propertyCode String?
  starRating   Int?
  pointsTotal  Int // whole stay
  sortOrder    Int      @default(0) // ascending points
  refreshedAt  DateTime @default(now())

  @@unique([cityId, programme])
  @@index([cityId, sortOrder])
}

model ExploreAvailability {
  id     String @id @default(cuid())
  cityId String
  city   ExploreCity @relation(fields: [cityId], references: [id], onDelete: Cascade)

  originCode     String // 'LON'
  month          String // '2026-06'
  seatsFound     Int     @default(0)
  cheapestPoints Int?
  programme      String?
  refreshedAt    DateTime @default(now())

  @@unique([cityId, originCode, month])
  @@index([cityId, originCode, month])
}

model ExploreRoute {
  id String @id @default(cuid())

  originCode  String // 'LON' — city code, not airport
  countryCode String
  country     ExploreCountry @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  cityId String? // null = country-level aggregate row (cheapest across its cities)
  city   ExploreCity? @relation(fields: [cityId], references: [id], onDelete: Cascade)

  cashFrom        Int // £, cheapest return, whole pounds
  pointsFrom      Int // cheapest award, in the programme below
  pointsProgramme String // 'ba_avios'
  awardSeatsOpen  Boolean @default(false)

  refreshedAt DateTime @default(now())

  @@unique([originCode, countryCode, cityId])
  @@index([originCode, cashFrom])
}

model PopularTrip {
  id String @id @default(cuid())

  originCode String // 'LHR' — the city this trip is offered from
  originCity String // 'London'
  destCode   String // 'LIS'
  destCity   String // 'Lisbon'
  routeLabel String // 'London to Lisbon'

  imageUrl String
  gradient String

  departDate DateTime
  returnDate DateTime
  nights     Int      @default(5)
  adults     Int      @default(2)

  // Cash route — flight + hotel (whole-pound total)
  cashTotal Int

  // Points route — flight award + hotel award, or a mix
  flightPoints   Int?
  flightCurrency String? // 'Avios'
  hotelPoints    Int?
  hotelProgramme String? // 'world_of_hyatt'
  residualCash   Int     @default(0) // £ still payable on the points route

  awardAvailable Boolean @default(false) // drives the green tag
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  refreshedAt    DateTime @default(now())

  @@unique([originCode, destCode])
  @@index([originCode, isActive, sortOrder])
}
